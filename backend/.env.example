# RailBite Backend Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (MongoDB Atlas or Local)
# Example for MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/railbite?retryWrites=true&w=majority
# Example for Local MongoDB:
MONGODB_URI=mongodb://localhost:27017/railbite

# JWT Secret for Passenger and Admin Authentication
JWT_SECRET=railbite-super-secret-security-key-2026
